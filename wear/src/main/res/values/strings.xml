<?xml version="1.0" encoding="utf-8"?>
<!-- The screen strings, in the eleven languages the Zepp OS original shipped.
     Android resolves the watch's locale to the right table on its own, so
     Kazakh - which Zepp OS had no device-language code for - finally reaches the
     people it was translated for.

     Adding a language means adding one values-<code>/strings.xml with every key
     below; Android Lint's MissingTranslation check is an error here, so a table
     that is short of a key fails the build rather than falling back silently.

     Keep each label short. Nothing on a round watch screen auto-shrinks, so a
     label that outgrows its button is simply clipped. -->
<resources>
    <!-- The name the launcher shows. Deliberately not translated: it is the
         name the app is published under, the same one the Zepp OS app carries. -->
    <string name="app_name" translatable="false">Snake Classic</string>
    <!-- The title over the start menu; shorter than the launcher name, which has a whole screen to sit on. -->
    <string name="title">Snake</string>
    <!-- The running score, in the cap above the board. -->
    <string name="score_value">Score %1$d</string>
    <!-- The record for the difficulty currently chosen; each keeps its own. -->
    <string name="best_value">Best %1$d</string>
    <string name="play">Play</string>
    <string name="resume">Resume</string>
    <string name="again">Again</string>
    <string name="paused">Paused</string>
    <string name="game_over">Game over</string>
    <string name="new_best">New best!</string>
    <string name="speed">Speed</string>
    <string name="speed_slow">Slow</string>
    <string name="speed_normal">Normal</string>
    <string name="speed_fast">Fast</string>
    <!-- A full sentence under the start menu, so it gets a wider allowance than the words on the buttons. -->
    <string name="hint">Swipe or tap arrows</string>
    <!-- Spoken descriptions of the five on-screen controls; never drawn. -->
    <string name="steer_up">Up</string>
    <string name="steer_down">Down</string>
    <string name="steer_left">Left</string>
    <string name="steer_right">Right</string>
    <string name="pause">Pause</string>
</resources>
